# --- SiteTracker Analytics environment configuration ---
# Copy this file to .env and adjust as needed.

# Database. Defaults to local SQLite file. Point at Postgres for prod-like runs:
# DATABASE_URL=postgresql+psycopg2://sitetracker:sitetracker@db:5432/sitetracker
DATABASE_URL=sqlite:///./data/sitetracker.db

# Safety switch. Live scraping of real websites is DISABLED by default.
# Only set to true if you understand and accept the ethics/robots.txt notes in the README.
ENABLE_LIVE_MONITORING=false

# HTTP fetch behaviour (only relevant when ENABLE_LIVE_MONITORING=true)
USER_AGENT="SiteTrackerAnalyticsBot/0.1 (+https://github.com/yourname/site-tracker-analytics; portfolio project)"
REQUEST_TIMEOUT_SECONDS=15
REQUEST_MAX_RETRIES=2
PER_DOMAIN_DELAY_SECONDS=3.0

# Persist a snapshot even if content hash matches the previous one
STORE_DUPLICATE_SNAPSHOTS=false

# Scheduler
ENABLE_SCHEDULER=false

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-me
